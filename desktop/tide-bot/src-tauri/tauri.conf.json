{
	"$schema": "https://schema.tauri.app/config/2.0.0",
	"productName": "Tide-Bot",
	"version": "0.1.0",
	"identifier": "com.tidebot.desktop",
    "build": {
        "beforeBuildCommand": "",
        "beforeDevCommand": "",
        "frontendDist": "../../../build"
    },
	"app": {
		"withGlobalTauri": false,
		"security": {
			"csp": "default-src 'self'; connect-src 'self' ipc: https://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'",
			"assetProtocol": {
				"enable": true,
				"scope": []
			}
		},
		"windows": [
			{
				"label": "main",
				"title": "Tide-Bot",
				"width": 1280,
				"height": 800,
				"minWidth": 800,
				"minHeight": 600,
				"resizable": true,
				"fullscreen": false,
				"visible": true,
				"decorations": true
			}
		],
		"trayIcon": {
			"id": "tide-bot-main-tray",
			"iconPath": "icons/tray.png",
			"iconAsTemplate": true,
			"menuOnLeftClick": false
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png"
        ],
		"category": "Productivity",
		"shortDescription": "Tide-Bot companion desktop shell",
		"longDescription": "Native macOS/Windows shell hosting the Tide-Bot companion window with a single typed-chat surface and a tray.",
		"publisher": "Tide-Bot Project",
		"copyright": "Apache-2.0",
		"macOS": {
			"minimumSystemVersion": "10.15"
		},
		"windows": {
			"certificateThumbprint": "",
			"digestAlgorithm": "sha256",
			"timestampUrl": ""
		}
	},
	"plugins": {}
}

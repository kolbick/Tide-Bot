# Tauri desktop shell: only the resolver-written artifacts are untracked.
# Hand-edited fallbacks for the capability/provenance are disallowed.
# Test fixtures under tests/fixtures/ are tracked by the integration tests
# (companion_url_test.rs uses a stale-nonce pair to prove rejection).
/src-tauri/capabilities/companion.json
/src-tauri/generated/
/src-tauri/target/
/src-tauri/.cargo/config.toml
node_modules/
.package-lock.json
/src-tauri/gen/
# /src-tauri/icons/icon.ico is intentionally TRACKED. The Tauri Windows build
# requires a real multi-size .ico file to embed in the .exe resource.
# The companion macOS build uses the .png files via tauri.conf.json, so the
# (rarely-needed) icon.icns remains untracked.
/src-tauri/icons/icon.icns

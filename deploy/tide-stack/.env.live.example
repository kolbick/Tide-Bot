# Required: preserve the existing application encryption secret as a non-empty random value.
WEBUI_SECRET_KEY=

# Optional when configured: uncomment and preserve the existing OAuth client-info encryption key unchanged.
# OAUTH_CLIENT_INFO_ENCRYPTION_KEY=explicit-nonempty-value

# Required at deployment: immutable Git commit selected by the validated updater.
TIDE_BOT_COMMIT=

# Optional: loopback host port number; the public ingress remains Cloudflared.
TIDEBOT_OPEN_WEBUI_PORT=

# Optional: exact semicolon-separated HTTPS origins permitted by Socket.IO and the API.
CORS_ALLOW_ORIGIN=

# Optional provider settings: enabled flag, base URLs, API keys, and JSON configuration.
ENABLE_OPENAI_API=
OPENAI_API_BASE_URL=
OPENAI_API_BASE_URLS=
OPENAI_API_KEY=
OPENAI_API_KEYS=
OPENAI_API_CONFIGS=

# Optional provider settings: enabled flag, base URLs, and JSON configuration for Ollama.
ENABLE_OLLAMA_API=
OLLAMA_API_BASE_URL=
OLLAMA_BASE_URL=
OLLAMA_BASE_URLS=
OLLAMA_API_CONFIGS=

# Optional internal terminal settings: JSON connection metadata and proxy headers; never publish a terminal port.
TERMINAL_SERVER_CONNECTIONS=
TERMINAL_PROXY_HEADERS=
ENABLE_TERMINAL=

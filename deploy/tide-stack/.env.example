# Public Tide-Bot endpoint. Put this behind the reverse proxy for tide-bot.com.
APP_HOST_PORT=3102

# Generate separately, for example: openssl rand -hex 32
WEBUI_SECRET_KEY=replace-with-a-long-random-secret
TIDE_TERMINAL_API_KEY=replace-with-a-long-random-secret
TIDE_CPTR_GATE_TOKEN=replace-with-a-long-random-secret

# CPTR runs on the host computer. Create its gateway key in CPTR Settings > Gateway.
# Docker Desktop: http://host.docker.internal:8000/v1
# Linux Docker: the compose file supplies the host-gateway mapping above.
CPTR_GATEWAY_URL=http://host.docker.internal:8000/v1
CPTR_GATEWAY_API_KEY=sk-cptr-replace-me

# Admins always have CPTR. Add approved non-admin email addresses here, comma-separated.
# Restart only tide-cptr-gateway after changing this list.
TIDE_CPTR_APPROVED_EMAILS=

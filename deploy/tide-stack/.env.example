# Public Tide-Bot endpoint. Put this behind the reverse proxy for tide-bot.com.
APP_HOST_PORT=3102

# Optional explicit CORS override. Leave this unset for the local testing
# defaults. Production uses docker-compose.production.yml, which permits only
# https://tide-bot.com and https://www.tide-bot.com. Never use *.
# CORS_ALLOW_ORIGIN=

# Generate separately, for example: openssl rand -hex 32. Do not reuse this
# secret in another application or Compose project.
WEBUI_SECRET_KEY=replace-with-a-long-random-secret

# Optional Tide Terminal overlay only.
TIDE_TERMINAL_API_KEY=replace-with-a-long-random-secret

# Optional CPTR overlay only. Leave CPTR disabled unless the operator has
# reviewed the host-level access boundary documented in README.md.
TIDE_CPTR_GATE_TOKEN=replace-with-a-long-random-secret

# CPTR runs on the host computer. Create its gateway key in CPTR Settings > Gateway.
# Docker Desktop: http://host.docker.internal:8000/v1
# Linux Docker: the compose file supplies the host-gateway mapping above.
CPTR_GATEWAY_URL=http://host.docker.internal:8000/v1
CPTR_GATEWAY_API_KEY=sk-cptr-replace-me

# Admins always have CPTR. Add approved non-admin email addresses here,
# comma-separated. Restart only tide-cptr-gateway after changing this list.
TIDE_CPTR_APPROVED_EMAILS=

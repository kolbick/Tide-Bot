{
	"manifest_version": 3,
	"name": "Tide-Bot Browser Control",
	"short_name": "Tide-Bot",
	"description": "Secure, single-tab browser control for your private Tide-Bot assistant.",
	"version": "0.1.0",
	"minimum_chrome_version": "120",
	"key": "",
	"permissions": [
		"activeTab",
		"alarms",
		"debugger",
		"downloads",
		"notifications",
		"sidePanel",
		"storage",
		"tabs"
	],
	"host_permissions": ["<all_urls>"],
	"background": {
		"service_worker": "service-worker.js",
		"type": "module"
	},
	"action": {
		"default_title": "Open Tide-Bot",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png",
			"48": "icons/icon-48.png",
			"128": "icons/icon-128.png"
		}
	},
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"side_panel": {
		"default_path": "sidepanel.html"
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["content-script.js"],
			"run_at": "document_idle",
			"all_frames": false
		}
	],
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
	}
}
